# Security configuration for the AMECF Framework (Example Template)
# Copy this file to .env and configure your secrets

# The secure token required for Frontend-to-Backend communication
API_SECRET_KEY=your-secure-api-token-here

# Database / Storage Paths
DATA_DIR=data/20m_dataset
GRAPH_DIR=data/graph

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
